# Contact form delivery (app/api/contact/route.ts).
# Without all three set, the form returns an error instead of silently
# dropping the lead. Add the same three in Vercel → Settings → Environment Variables.

# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Where enquiries land — use an inbox you actually read.
CONTACT_TO_EMAIL=faisal@mehvoralab.com

# Must be on a domain verified in Resend, otherwise sending is rejected.
CONTACT_FROM_EMAIL=website@mehvoralab.com
